generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStage {
  SAVED
  APPLIED
  RECRUITER_SCREEN
  TECH_SCREEN
  ONSITE
  OFFER
  REJECTED
  WITHDRAWN
  ARCHIVED
}

enum RemoteMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum InterviewType {
  BEHAVIORAL
  TECHNICAL
  SYSTEM_DESIGN
  HIRING_MANAGER
  RECRUITER
  PANEL
  OTHER
}

enum InterviewFormat {
  PHONE
  VIDEO
  ONSITE
  TAKE_HOME
  OTHER
}

enum InterviewOutcome {
  SCHEDULED
  COMPLETED
  PASSED
  FAILED
  CANCELLED
  UNKNOWN
}

enum InterviewNoteType {
  PREP
  RAW_POST_INTERVIEW
  STRUCTURED_ANALYSIS
  FEEDBACK
  FOLLOW_UP_DRAFT
}

enum FollowUpType {
  EMAIL
  LINKEDIN
  THANK_YOU
  CHECK_IN
  PREP_TASK
  OTHER
}

enum ActivityEntityType {
  COMPANY
  APPLICATION
  CONTACT
  INTERVIEW
  INTERVIEW_NOTE
  FOLLOW_UP
}

enum ActivityEventType {
  CREATED
  UPDATED
  DELETED
  COMPLETED
  REOPENED
  STAGE_CHANGED
  OUTCOME_CHANGED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String
  companies      Company[]
  applications   Application[]
  contacts       Contact[]
  interviews     Interview[]
  interviewNotes InterviewNote[]
  followUps      FollowUp[]
  activityEvents ActivityEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Company {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  industry     String?
  location     String?
  notes        String?
  applications Application[]
  contacts     Contact[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model Application {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleTitle       String
  jobUrl          String?
  source          String?
  stage           ApplicationStage @default(SAVED)
  compensationMin Int?
  compensationMax Int?
  remoteMode      RemoteMode       @default(UNKNOWN)
  priority        Priority         @default(MEDIUM)
  confidence      Int?
  concerns        String?
  nextAction      String?
  nextActionAt    DateTime?
  notes           String?
  contacts        Contact[]
  interviews      Interview[]
  followUps       FollowUp[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, stage])
  @@index([companyId])
}

model Interview {
  id                    String           @id @default(uuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId         String
  application           Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundName             String
  roundNumber           Int
  type                  InterviewType
  format                InterviewFormat
  scheduledAt           DateTime
  durationMinutes       Int
  interviewers          String?
  expectedTopics        String?
  prepNotes             String?
  rawPostInterviewNotes String?
  outcome               InterviewOutcome @default(SCHEDULED)
  notes                 InterviewNote[]
  followUps             FollowUp[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([userId, scheduledAt])
  @@index([applicationId])
}

model InterviewNote {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewId String
  interview   Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  type        InterviewNoteType
  body        String
  analysis    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([interviewId])
}

model FollowUp {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  interviewId   String?
  interview     Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  title         String
  dueAt         DateTime
  completedAt   DateTime?
  priority      Priority
  type          FollowUpType
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, dueAt])
  @@index([applicationId])
  @@index([contactId])
  @@index([interviewId])
}

model Contact {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name          String
  role          String?
  email         String?
  phone         String?
  linkedinUrl   String?
  notes         String?
  followUps     FollowUp[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([applicationId])
}

model ActivityEvent {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType ActivityEntityType
  entityId   String
  eventType  ActivityEventType
  occurredAt DateTime           @default(now())
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
}
